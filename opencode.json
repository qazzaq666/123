{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    ".opencode/rules/git-delegation.md"
  ],
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "git-warden": "allow"
        },
        "bash": {
          "*": "allow",
          "git *": "deny"
        }
      }
    }
  }
}
