{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "git-warden": "allow"
        },
        "bash": {
          "*": "allow",
          "git *": "deny"
        }
      }
    }
  }
}
